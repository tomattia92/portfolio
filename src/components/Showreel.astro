---
// Showreel 15s. Parte da solo (muto, in loop) a meno che l'utente preferisca meno animazioni.
---
<figure class="relative overflow-hidden rounded-2xl bg-ink shadow-[0_30px_80px_-30px_rgba(0,0,0,.45)]">
  <video
    id="showreel"
    class="aspect-video w-full"
    poster="/video/poster.jpg"
    width="1920"
    height="1080"
    muted
    loop
    playsinline
    preload="metadata"
    aria-label="Showreel di 15 secondi: «born to be wild, born to be tech», tra motion design e codice"
  >
    <source src="/video/showreel.webm" type="video/webm" />
    <source src="/video/showreel.mp4" type="video/mp4" />
    Il tuo browser non supporta i video. <a href="/video/showreel.mp4">Scarica lo showreel</a>.
  </video>
  <figcaption class="sr-only">Showreel: da «wild» a «tech» in 15 secondi, tra tipografia in movimento, tecnologie e codice.</figcaption>
</figure>

<script>
  const video = document.querySelector<HTMLVideoElement>("#showreel");
  if (video) {
    // Chi preferisce meno animazioni non vede partire nulla da solo: gli diamo i controlli nativi.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) video.controls = true;
    else video.play().catch(() => (video.controls = true));
  }
</script>
